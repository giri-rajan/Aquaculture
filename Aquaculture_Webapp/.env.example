# ---- Gemini (the only model provider this app uses) -------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Every agent uses exactly this model. Use any Gemini model your key can access,
# as listed in AI Studio (for example gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash

# Optional. A small Gemma model on the same key writes the "first alert" the moment an anomaly opens,
# before the full diagnosis. Use a Gemma model id your key lists in AI Studio (for example gemma-4-26b-a4b-it,
# which answers in about 2 s). Empty = a fixed rule writes it.
GEMMA_MODEL=
# Optional. A Gemini Live (native audio) model turns on spoken conversation in Ask the Lake and the
# farmer view. Use a Live-capable model id your key lists in AI Studio (for example gemini-3.8-live).
# Empty = the Talk button is hidden.
GEMINI_LIVE_MODEL=

# ---- Data source ------------------------------------------------------------
# simulator = built-in lake simulator (demo).  boat = wait for the real boat on POST /api/ingest
DATA_SOURCE=simulator
# If set, POST /api/ingest needs the header  X-API-Key: <value>
INGEST_API_KEY=

# ---- Paths and ports --------------------------------------------------------
# Folder holding the fish-health model service (app/ and models/)
MODEL_DIR=../Aquaculture_Model
BACKEND_PORT=8080
# How the boat re-plans after an anomaly: gemini (Planner agent decides) or onboard (fixed rule).
# Falls back to onboard when Gemini is not configured or a call fails.
REPLAN_MODE=gemini

# ---- Deployment only --------------------------------------------------------
# Web origins allowed to call the API from another host, comma-separated
# (for example your Firebase Hosting URL). Leave empty when the backend serves the app itself.
ALLOWED_ORIGINS=
# Shared login for a public URL (browser asks once). Leave the password empty for local use.
APP_USERNAME=aquasentinel
APP_PASSWORD=
