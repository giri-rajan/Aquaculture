# ---- Gemini (the only model provider this app uses) -------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Every agent uses exactly this model. Use any Gemini model your key can access,
# as listed in AI Studio (for example gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash

# ---- Data source ------------------------------------------------------------
# simulator = built-in lake simulator (demo).  boat = wait for the real boat on POST /api/ingest
DATA_SOURCE=simulator
# If set, POST /api/ingest needs the header  X-API-Key: <value>
INGEST_API_KEY=

# ---- Paths and ports --------------------------------------------------------
# Folder holding the fish-health model service (app/ and models/)
MODEL_DIR=../Aquaculture_Model
BACKEND_PORT=8080
# How the boat re-plans after an anomaly: gemini (Planner agent decides) or onboard (fixed rule).
# Falls back to onboard when Gemini is not configured or a call fails.
REPLAN_MODE=gemini

# ---- Deployment only --------------------------------------------------------
# Web origins allowed to call the API from another host, comma-separated
# (for example your Firebase Hosting URL). Leave empty when the backend serves the app itself.
ALLOWED_ORIGINS=
